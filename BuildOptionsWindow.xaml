<Window x:Class="Sm64DecompLevelViewer.BuildOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build Configuration" Height="580" Width="480"
        Background="#1E1E1E" Foreground="#CCCCCC"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#252526"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="TextBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00A2FF"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#569CD6"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#2A2D2E"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D13438"/>

        <!-- Label Style -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,5,0"/>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Surface" Background="#252526" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="6,3">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="▾" Foreground="#CCCCCC" Margin="8,0,0,0"/>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center" TextElement.Foreground="#CCCCCC"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#34343A"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                                <Border Background="#252526" BorderBrush="#707078" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Toggle" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Toggle" Property="BorderBrush" Value="#00A2FF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <!-- These overrides force standard WPF ComboBox to render with our dark background and text colors -->
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#252526" />
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#CCCCCC" />
            </Style.Resources>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#094771"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>

        <!-- Circular Help Button Style -->
        <Style x:Key="HelpButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#00A2FF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Settings content -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock Text="Build Options" FontSize="18" FontWeight="Bold" Foreground="{StaticResource HeaderBrush}" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock x:Name="ProfileNotice" Foreground="#D7BA7D" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <GroupBox Header="Base ROM" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource HeaderBrush}" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <Button x:Name="SelectRomButton" Content="Select ROM" Click="SelectRom_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="RomStatusText" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="Select the original .z64 ROM for the chosen Version. The source is remembered and copied into this repository when needed." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>
                <!-- Group 1: Make Flags -->
                <GroupBox Header="SM64 Build Parameters" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource HeaderBrush}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- TARGET PLATFORM -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Target Platform:" Margin="0,4"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PlatformComboBox" Margin="0,4" SelectionChanged="PlatformComboBox_SelectionChanged">
                            <ComboBoxItem Content="N64 ROM" IsSelected="True"/>
                            <ComboBoxItem Content="PC Port"/>
                        </ComboBox>

                        <!-- BUILD ENVIRONMENT -->
                        <Label Grid.Row="1" Grid.Column="0" x:Name="EnvLabel" Content="Build Environment:" Margin="0,4" Visibility="Collapsed"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="EnvComboBox" Margin="0,4" Visibility="Collapsed" SelectionChanged="EnvComboBox_SelectionChanged">
                            <ComboBoxItem Content="WSL (Ubuntu)" IsSelected="True"/>
                            <ComboBoxItem Content="MSYS2 (Native Windows)"/>
                        </ComboBox>

                        <!-- MSYS2 DIRECTORY -->
                        <Label Grid.Row="2" Grid.Column="0" x:Name="MsysLabel" Content="MSYS2 Path:" Margin="0,4" Visibility="Collapsed"/>
                        <Grid Grid.Row="2" Grid.Column="1" x:Name="MsysGrid" Visibility="Collapsed" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MsysPathTextBox" Text="C:\msys64" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="BrowseMsysButton" Content="Browse..." Margin="5,0,0,0" Padding="10,0" Click="BrowseMsysButton_Click"/>
                        </Grid>

                        <!-- VERSION -->
                        <Label Grid.Row="3" Grid.Column="0" Content="Version:" Margin="0,4"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="VersionComboBox" Margin="0,4" SelectionChanged="VersionComboBox_SelectionChanged">
                            <ComboBoxItem Content="us" IsSelected="True"/>
                            <ComboBoxItem Content="jp"/>
                            <ComboBoxItem Content="eu"/>
                            <ComboBoxItem Content="sh"/>
                            <ComboBoxItem Content="cn"/>
                        </ComboBox>

                        <!-- COMPILER -->
                        <Label Grid.Row="4" Grid.Column="0" Content="Compiler:" Margin="0,4"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CompilerComboBox" Margin="0,4" SelectionChanged="CompilerComboBox_SelectionChanged">
                            <ComboBoxItem Content="ido" IsSelected="True"/>
                            <ComboBoxItem Content="gcc"/>
                        </ComboBox>

                        <!-- GRUCODE -->
                        <Label Grid.Row="5" Grid.Column="0" Content="RSP Microcode:" Margin="0,4"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="GrucodeComboBox" Margin="0,4">
                            <ComboBoxItem Content="f3d_old" IsSelected="True"/>
                            <ComboBoxItem Content="f3d_new"/>
                            <ComboBoxItem Content="f3dex"/>
                            <ComboBoxItem Content="f3dex2"/>
                            <ComboBoxItem Content="f3dzex"/>
                        </ComboBox>

                        <!-- JOBS -->
                        <Label Grid.Row="6" Grid.Column="0" Content="Parallel Jobs (-j):" Margin="0,4"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="JobsTextBox" Text="8" Margin="0,4" PreviewTextInput="NumberValidationTextBox"/>

                        <!-- CHECKBOXES -->
                        <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,5,0,0">
                            <CheckBox x:Name="CompareCheckBox" Content="Compare ROM hash (COMPARE=1)"/>
                            <CheckBox x:Name="CorruptorRomCheckBox" Content="Also build a 24 MiB ROM for corruptors" ToolTip="Builds a separate ROM with literal MIO0 asset data and a build-specific range report."/>
                            <CheckBox x:Name="NonMatchingCheckBox" Content="Build non-matching (NON_MATCHING=1)"/>
                            <CheckBox x:Name="ExtendRomCheckBox" Content="Extend ROM to 24MB (Uncompressed MIO0)" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Group 2: Emulator Settings -->
                <GroupBox Header="Emulator Configuration" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource HeaderBrush}" Padding="8" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0" x:Name="EmulatorPathTextBox" Margin="0,4" IsReadOnly="True"/>
                        <Button Grid.Row="0" Grid.Column="1" x:Name="BrowseEmulatorButton" Content="..." Click="BrowseEmulator_Click" Margin="5,4,0,4" Width="40"/>

                        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="AutoRunCheckBox" Content="Auto-launch emulator after successful build" Margin="0,4"/>
                    </Grid>
                </GroupBox>

                <!-- Group 3: Reset & Clean Project -->
                <GroupBox Header="Reset &amp; Clean Project" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource HeaderBrush}" Padding="8" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Git Repository:"/>
                            <TextBox Grid.Column="1" x:Name="GitUrlTextBox" Text="https://github.com/n64decomp/sm64.git"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Button Content="Clean &amp; Fresh Start (Re-clone)" Click="CleanAndClone_Click" Background="{StaticResource WarningBrush}" BorderBrush="{StaticResource WarningBrush}" Foreground="White"/>
                            <Button Content="Revert Source Changes" Click="RevertSource_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Re-clone wipes the directory completely (keeps baseroms). Revert only discards file edits, keeping builds." FontSize="10" Foreground="#888888" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Repository Build Support" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource HeaderBrush}" Padding="8" Margin="0,10,0,0">
                    <TextBlock Foreground="#CCCCCC" TextWrapping="Wrap"
                               Text="Available targets and options come from this repository. Native PC builds use GCC. N64 builds use the repository compiler and cross-toolchain. Repeat builds preserve compatible outputs and let make rebuild changed dependencies."/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="BuildButton" Grid.Column="1" Content="Build &amp; Run" Click="Build_Click" Background="{StaticResource AccentBrush}" BorderThickness="0" Foreground="White" Width="100" FontWeight="Bold"/>
                <Button Grid.Column="2" Content="Cancel" Click="Cancel_Click" Margin="10,0,0,0" Width="80"/>
            </Grid>
        </Border>
    </Grid>
</Window>

