<Window x:Class="Sm64DecompLevelViewer.ScanDebuggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔍 Level Scan &amp; Model Parser Debugger" Height="550" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#CCCCCC">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Logs -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Top Header & Filter -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="🔍 LEVEL SCAN DEBUGGER" Foreground="#569CD6" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Search:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox x:Name="SearchTextBox" Width="220" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3" TextChanged="SearchTextBox_TextChanged"/>
            </StackPanel>
        </DockPanel>

        <!-- Log Display Box -->
        <Border Grid.Row="1" Background="#0C0C0C" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="3" Padding="5">
            <ScrollViewer x:Name="LogScrollViewer">
                <TextBox x:Name="LogTextBox" 
                         IsReadOnly="True" 
                         Background="Transparent" 
                         Foreground="#D4D4D4" 
                         BorderThickness="0" 
                         FontFamily="Consolas" 
                         FontSize="12"
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"/>
            </ScrollViewer>
        </Border>

        <!-- Bottom Actions -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Copy Logs" Click="CopyLogs_Click" Padding="12,5" Margin="0,0,5,0" Background="#3E3E42" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Open Log File" Click="OpenLogFile_Click" Padding="12,5" Margin="0,0,5,0" Background="#3E3E42" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Clear Logs" Click="ClearLogs_Click" Padding="12,5" Background="#3E3E42" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Close" Click="Close_Click" Width="90" Padding="5" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
