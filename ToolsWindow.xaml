<Window x:Class="Sm64DecompLevelViewer.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Randm64 Tools Dashboard" Height="620" Width="880" MinWidth="720" MinHeight="470"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#CCCCCC"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#252526"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
        
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#eeeeee"/></Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#252526"/><Setter Property="Foreground" Value="#eeeeee"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                                <Setter Property="Foreground" Value="#555555"/>
                                <Setter TargetName="border" Property="Background" Value="#252526"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Randm64 Tools Dashboard" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock x:Name="ActiveLevelText" Foreground="#bbbbbb" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <DockPanel>
                <TextBlock Text="Level:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="AreaPicker" DockPanel.Dock="Right" Width="130" Margin="8,0,0,0" ToolTip="Area used by the mesh editor"/>
                <ComboBox x:Name="LevelPicker" DisplayMemberPath="FullName" IsTextSearchEnabled="True" SelectionChanged="LevelPicker_Changed"/>
            </DockPanel>
        </StackPanel>
        
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><UniformGrid Columns="3">
            <Button Content="Star and objective editor" Click="Objectives_Click"/>
            <Button Content="Visual warp map" Click="WarpMap_Click"/>
            <Button Content="Collision diagnostics" Click="Diagnostics_Click"/>
            <Button Content="Sound bank inspector" Click="SoundBanks_Click"/>
            <Button Content="Project object search" Click="ObjectSearch_Click"/>
            <Button Content="Source editor · code blocks" Click="SourceEditor_Click"/>
            <!-- Level Specific Tools -->
            <Button x:Name="MeshToolButton" IsEnabled="False" Click="LevelMeshEditor_Click" ToolTip="Edit level vertices, geometry, and collision meshes.">
                <StackPanel>
                    <TextBlock Text="📐" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Level Mesh Viewer" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            
            <Button x:Name="PaintingToolButton" IsEnabled="False" Click="PaintingEditor_Click" ToolTip="Edit painting positions, rotations and sizes in painting source files.">
                <StackPanel>
                    <TextBlock Text="🖼️" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Painting Editor" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            
            <!-- Global Asset Tools -->
            <Button Click="ActorEditor_Click" ToolTip="Inspect and modify 3D character and object models.">
                <StackPanel>
                    <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Actor Editor" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            
            <Button Click="MusicEditor_Click" ToolTip="Manage and configure sequence notes and tracks.">
                <StackPanel>
                    <TextBlock Text="🎵" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Music Editor" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            
            <Button Click="SoundEditor_Click" ToolTip="Inspect audio samples and sounds.">
                <StackPanel>
                    <TextBlock Text="🔊" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sound Editor" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            
            <!-- System / Chaos Tools -->
            <Button Click="ChaosEngine_Click" ToolTip="Open the Chaos Engine interface.">
                <StackPanel>
                    <TextBlock Text="🔥" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Chaos Engine" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            
            <Button Click="BuildRom_Click" ToolTip="Configure build targets, clean repository clone, revert source, and compile SM64 ROM.">
                <StackPanel>
                    <TextBlock Text="⚙️" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Build ROM" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            
            <Button Click="BehaviorBuilder_Click" ToolTip="Create and compile custom entity behaviors using the behavior template builder.">
                <StackPanel>
                    <TextBlock Text="🧩" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Behavior Builder" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            
            <Button Click="TextEditor_Click" Content="Text and dialogue editor" ToolTip="Edit dialogue, menus and source files with search, conflict detection and backups."/>
            <Button Click="PatchTools_Click" Content="Git / WSL patches" ToolTip="Check and apply patches to the selected project."/>
            <Button Click="RomTools_Click" Content="ROM Address Finder" ToolTip="Inspect compiled map addresses and original reference ranges."/>
            <Button Click="OpenProjectFolder_Click" ToolTip="Open project folder in Windows Explorer.">
                <StackPanel>
                    <TextBlock Text="📁" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Open Project Folder" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </UniformGrid></ScrollViewer>
    </Grid>
</Window>
