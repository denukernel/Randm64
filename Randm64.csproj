<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Randm64</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\level_editor_icon.png" />
    <Resource Include="Assets\chaos_engine_icon.png" />
    <Resource Include="Assets\music_editor_icon.png" />
    <Resource Include="Assets\sound_editor_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
    <PackageReference Include="OpenTK" Version="4.8.0" />
    <PackageReference Include="AssimpNet" Version="5.0.0-beta1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ThirdParty\AssimpNet-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Tools\RomCorruptor\*.py" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Tests\**\*.cs" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
