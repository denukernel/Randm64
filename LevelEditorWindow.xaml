<Window x:Class="Sm64DecompLevelViewer.LevelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SM64 Level Editor" FontFamily="Segoe UI" Height="840" Width="1280" MinHeight="680" MinWidth="1050"
        Background="#1E1E1E" Foreground="#CCCCCC"
        Icon="Assets/icon.png"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#252526"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#569CD6"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3E3E42" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RibbonButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="#71839B" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="border" Property="Background" Value="#343E4D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#185577"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1,1,1,0" Margin="0,0,2,0" CornerRadius="3,3,0,0">
                            <ContentPresenter x:Name="content" ContentSource="Header" Margin="10,5" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="#9CDCFE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#454549"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="4"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2D2D30" />
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White" />
            </Style.Resources>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Ribbon -->
            <RowDefinition Height="*"/>    <!-- Workspace -->
        </Grid.RowDefinitions>

        <!-- 1. RIBBON MENU -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <TabControl Background="Transparent" BorderThickness="0">
                
                <TabItem Header="File">
                    <WrapPanel Margin="8,5">
                        <Button Click="SaveButton_Click" ToolTip="Save Level" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="&#xE105;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                <TextBlock Text="Save" HorizontalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </TabItem>
                
                <TabItem Header="Objects" IsEnabled="{Binding IsChecked, ElementName=ActorObjectMode}">
                    <WrapPanel Margin="8,5">
                        <Button Click="AddObject_Click" ToolTip="Add normal, macro or special object at the camera target" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                <TextBlock Text="Object" HorizontalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Click="PerformCopy" ToolTip="Copy Object" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                <TextBlock Text="Copy" HorizontalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Click="PerformPaste" ToolTip="Paste Object" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                <TextBlock Text="Paste" HorizontalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Click="GroundObject_Click" ToolTip="Place the selected object on terrain at its X/Z position" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel><TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center"/><TextBlock Text="Ground" FontSize="11"/></StackPanel>
                        </Button>
                        <Button Click="RestoreRemovedObject_Click" ToolTip="Restore the last removed object, including after saving" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel><TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center"/><TextBlock Text="Restore" FontSize="11"/></StackPanel>
                        </Button>
                        <Button Click="RemoveObject_Click" ToolTip="Delete Selected" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                <TextBlock Text="Delete" HorizontalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </TabItem>

                <TabItem Header="Tools">
                    <WrapPanel Margin="8,5">
                        <Button Click="ToolsDashboardButton_Click" ToolTip="Open standalone Tools Dashboard Window" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center" Foreground="#007ACC"/>
                                <TextBlock Text="Dashboard" HorizontalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Click="TestButton_Click" ToolTip="Test Level (Requires Emulator)" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center" Foreground="#B5CEA8"/>
                                <TextBlock Text="Build / test" HorizontalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Click="ActorEditorButton_Click" ToolTip="Actor Viewer &amp; Editor" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center" Foreground="#CE9178"/>
                                <TextBlock Text="Actors" HorizontalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Click="LevelMusic_Click" ToolTip="Assign music to this level" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="&#xE142;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center" Foreground="#4FC9B0"/>
                                <TextBlock Text="Level music" HorizontalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Click="MusicEditorButton_Click" ToolTip="M64 Music Editor" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center" Foreground="#4FC1FF"/>
                                <TextBlock Text="Music" HorizontalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Click="LevelMeshEditorButton_Click" ToolTip="Level mesh viewer (editable tables)" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center" Foreground="#E080C0"/>
                                <TextBlock Text="Mesh viewer" HorizontalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Click="WarpEditorButton_Click" ToolTip="Warp Nodes Editor" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center" Foreground="#35A0D0"/>
                                <TextBlock Text="Warps" HorizontalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Click="PaintingEditorButton_Click" ToolTip="Painting Structures Editor" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center" Foreground="#E6A23C"/>
                                <TextBlock Text="Paintings" HorizontalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Click="PatchButton_Click" ToolTip="Apply Source Patch (WSL/Git)" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center" Foreground="#E57373"/>
                                <TextBlock Text="Patch" HorizontalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Click="HelpButton_Click" ToolTip="Camera, object and mesh controls" Style="{StaticResource RibbonButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center" Foreground="#DCDCAA"/>
                                <TextBlock Text="Controls" HorizontalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </TabItem>
            </TabControl>
        </Border>

        <!-- 2. MAIN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="280"/> <!-- Sidebar -->
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="500"/>   <!-- Viewport + Controls -->
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="#3F3F46" BorderThickness="0,0,1,0">
                <Grid>
                  <Grid x:Name="ObjectModePanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search -->
                        <RowDefinition Height="2*"/>   <!-- Object List -->
                        <RowDefinition Height="3*"/>   <!-- Property Grid -->
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <Border Background="#333333" Margin="5" CornerRadius="3" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" VerticalAlignment="Center" Opacity="0.5" Margin="0,0,5,0"/>
                            <TextBox Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" 
                                     Text="Search objects..." FontSize="12" Opacity="0.8" Name="SearchBox"
                                     TextChanged="SearchBox_TextChanged"
                                     GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"/>
                        </Grid>
                    </Border>

                    <!-- Object/Warp List -->
                    <TabControl x:Name="SidebarTabControl" SelectionChanged="IntroTab_Changed" Grid.Row="1" Margin="0,5">
                        <TabItem Header="Objects">
                            <TreeView x:Name="ObjectTreeView" Background="Transparent" BorderThickness="0"
                                      SelectedItemChanged="ObjectTreeView_SelectedItemChanged" Margin="0,5">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                        <Setter Property="Padding" Value="2"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeViewItem Header="NORMAL" x:Name="NormalObjectsNode" IsExpanded="True" Foreground="#569CD6"/>
                                <TreeViewItem Header="MACRO" x:Name="MacroObjectsNode" IsExpanded="True" Foreground="#6A9955"/>
                                <TreeViewItem Header="SPECIAL" x:Name="SpecialObjectsNode" IsExpanded="True" Foreground="#DCDCAA"/>
                            </TreeView>
                        </TabItem>
                        <TabItem Header="Cutscene">
                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Select Spline -->
                                    <RowDefinition Height="*"/>    <!-- List of Points -->
                                    <RowDefinition Height="Auto"/> <!-- Editing details -->
                                    <RowDefinition Height="Auto"/> <!-- Actions -->
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Margin="0,0,0,5">
                                    <CheckBox x:Name="IntroActorsCheckBox" Content="Preview Peach and Lakitu" IsChecked="True" Checked="IntroPreview_Changed" Unchecked="IntroPreview_Changed" Foreground="White" Margin="0,4"/>
                                    <Button x:Name="PeachPositionButton" Content="Edit / focus Peach position..." Click="PeachPosition_Click" Margin="0,4"/>
                                    <TextBlock Text="Select Camera Path:" Foreground="#CCCCCC" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="SplineSelector" SelectionChanged="SplineSelector_SelectionChanged">
                                        <ComboBoxItem Content="Intro Camera Path (Position)" Tag="sIntroStartToPipePosition"/>
                                        <ComboBoxItem Content="Intro Camera Path (Focus)" Tag="sIntroStartToPipeFocus"/>
                                        <ComboBoxItem Content="Intro Pipe to Dialog (Position)" Tag="sIntroPipeToDialogPosition"/>
                                        <ComboBoxItem Content="Intro Pipe to Dialog (Focus)" Tag="sIntroPipeToDialogFocus"/>
                                    </ComboBox>
                                </StackPanel>
                                
                                <ListBox Grid.Row="1" x:Name="SplinePointListBox" SelectionChanged="SplinePointListBox_SelectionChanged" Background="White" Foreground="Black" BorderBrush="#3F3F46" Margin="0,5">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="Black" FontSize="12"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                
                                <StackPanel Grid.Row="2" Margin="0,5" x:Name="SplineEditorFields" Visibility="Collapsed">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Speed:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="SplineSpeedText" TextChanged="SplineField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="X:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="SplineXText" TextChanged="SplineField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Y:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="SplineYText" TextChanged="SplineField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Z:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="SplineZText" TextChanged="SplineField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                    </Grid>
                                </StackPanel>
                                
                                <Grid Grid.Row="3" Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0" Content="Add Point" Click="AddSplinePoint_Click" Margin="2" Background="#007ACC" Foreground="White" BorderThickness="0" Padding="5"/>
                                    <Button Grid.Row="0" Grid.Column="1" Content="Remove Point" Click="RemoveSplinePoint_Click" Margin="2" Background="#D13438" Foreground="White" BorderThickness="0" Padding="5"/>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                        <Button Content="Play / Pause camera" Click="PlayPathPreview_Click" Margin="2,5" Background="#107C41" Foreground="White" BorderThickness="0" Padding="6"/>
                                        <Button Content="Stop" Click="StopPathPreview_Click" Margin="2,5" Background="#444" Foreground="White" BorderThickness="0" Padding="6"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Mesh">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Dropdown selection -->
                                    <RowDefinition Height="Auto"/> <!-- List of items (fixed height) -->
                                    <RowDefinition Height="*"/>    <!-- Scrollable fields and actions -->
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Margin="0,0,0,5">
                                    <TextBlock Text="Select Geometry Type:" Foreground="#CCCCCC" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="MeshTypeSelector" SelectionChanged="MeshTypeSelector_SelectionChanged">
                                        <ComboBoxItem Content="Collision Vertices" Tag="ColVertices" IsSelected="True"/>
                                        <ComboBoxItem Content="Collision Triangles" Tag="ColTriangles"/>
                                        <ComboBoxItem Content="Water Boxes" Tag="WaterBoxes"/>
                                    </ComboBox>
                                </StackPanel>
                                
                                <ListBox Grid.Row="1" x:Name="MeshItemListBox" Height="100" SelectionChanged="MeshItemListBox_SelectionChanged" Background="#252526" Foreground="White" BorderBrush="#3F3F46" Margin="0,5">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}" Foreground="White" FontSize="12"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,5">
                                    <StackPanel>
                                        <!-- Vertex Editor Fields -->
                                        <StackPanel x:Name="MeshVertexEditorFields" Visibility="Collapsed" Margin="0,5">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="X:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="MeshVertXText" TextChanged="MeshVertField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Y:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="MeshVertYText" TextChanged="MeshVertField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Z:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="MeshVertZText" TextChanged="MeshVertField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Triangle Editor Fields -->
                                        <StackPanel x:Name="MeshTriangleEditorFields" Visibility="Collapsed" Margin="0,5">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="V1:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="MeshTriV1Text" TextChanged="MeshTriField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="V2:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="MeshTriV2Text" TextChanged="MeshTriField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="V3:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="MeshTriV3Text" TextChanged="MeshTriField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Surface:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" x:Name="MeshTriSurfaceSelector" SelectionChanged="MeshTriSurfaceSelector_SelectionChanged"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Param:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="MeshTriParamText" TextChanged="MeshTriField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Water Box Editor Fields -->
                                        <StackPanel x:Name="MeshWaterEditorFields" Visibility="Collapsed" Margin="0,5">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="ID:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="MeshWaterIDText" TextChanged="MeshWaterField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="X1:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="MeshWaterX1Text" TextChanged="MeshWaterField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Z1:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="MeshWaterZ1Text" TextChanged="MeshWaterField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="X2:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="MeshWaterX2Text" TextChanged="MeshWaterField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Z2:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="MeshWaterZ2Text" TextChanged="MeshWaterField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Y:" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="MeshWaterYText" TextChanged="MeshWaterField_TextChanged" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="3"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Mesh Editor Actions -->
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0" Grid.Column="0" Content="Add Item" Click="AddMeshItem_Click" Margin="2" Background="#007ACC" Foreground="White" BorderThickness="0" Padding="5"/>
                                            <Button Grid.Row="0" Grid.Column="1" Content="Remove Item" Click="RemoveMeshItem_Click" Margin="2" Background="#D13438" Foreground="White" BorderThickness="0" Padding="5"/>
                                            <Button Grid.Row="1" Grid.ColumnSpan="2" Content="💾 Save Mesh Changes" Click="SaveMeshChanges_Click" Margin="2,5" Background="#107C41" Foreground="White" BorderThickness="0" Padding="6"/>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- Property Grid -->
                    <Border Grid.Row="2" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Properties" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                            
                            <Grid Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PropertyStack" Visibility="Collapsed">
                                        <Expander IsExpanded="True" Foreground="White">
                                            <Expander.Header>
                                                <TextBlock Text="GENERAL" FontWeight="Bold" Foreground="#9CDCFE"/>
                                            </Expander.Header>
                                            <Grid Margin="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Model" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,5,5" Foreground="{StaticResource HeaderBrush}"/>
                                                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ModelTextBox" IsReadOnly="True" Background="#333333" Foreground="White" BorderThickness="1" BorderBrush="#3F3F46" TextChanged="Coordinate_TextChanged" VerticalAlignment="Center" Padding="2"/>
                                                    <Button x:Name="SelectModelButton" Grid.Column="1" Content="..." Width="25" Margin="5,0,0,0" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="SelectModelButton_Click"/>
                                                </Grid>
                                                
                                                <TextBlock Text="Behavior" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{StaticResource HeaderBrush}"/>
                                                <Grid Grid.Row="1" Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="BehaviorTextBox" IsReadOnly="True" Background="#333333" Foreground="White" BorderThickness="1" BorderBrush="#3F3F46" MouseDoubleClick="BehaviorTextBox_MouseDoubleClick" VerticalAlignment="Center" Padding="2"/>
                                                    <Button x:Name="SelectBehaviorButton" Grid.Column="1" Content="..." Width="25" Margin="5,0,0,0" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="SelectBehaviorButton_Click"/>
                                                </Grid>
                                                <TextBlock x:Name="ModelCompatibilityText" Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#E5C07B" Margin="0,6,0,0" Visibility="Collapsed"/>
                                            </Grid>
                                        </Expander>

                                        <Expander IsExpanded="False" Foreground="White" Margin="0,5,0,0">
                                            <Expander.Header>
                                                <TextBlock Text="DATA" FontWeight="Bold" Foreground="#9CDCFE"/>
                                            </Expander.Header>
                                            <Grid Margin="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Address" Grid.Row="0" Margin="0,0,5,5" Foreground="{StaticResource HeaderBrush}"/>
                                                <TextBox x:Name="AddressTextBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Background="#2D2D30" Foreground="#DCDCAA" BorderThickness="0" Margin="0,0,0,5" Padding="2"/>
                                                
                                                <TextBlock Text="Params" Grid.Row="1" Margin="0,0,5,0" Foreground="{StaticResource HeaderBrush}"/>
                                                <TextBox x:Name="ParamsTextBox" Grid.Row="1" Grid.Column="1" Background="#333333" Foreground="#B5CEA8" BorderThickness="1" BorderBrush="#3F3F46" TextChanged="Coordinate_TextChanged" Padding="2"/>
                                            </Grid>
                                        </Expander>

                                        <Expander IsExpanded="True" Foreground="White" Margin="0,5,0,0">
                                            <Expander.Header>
                                                <TextBlock Text="TRANSFORM" FontWeight="Bold" Foreground="#9CDCFE"/>
                                            </Expander.Header>
                                            <Grid Margin="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
</Grid.RowDefinitions>

                                                <TextBlock Text="X" Margin="0,0,5,5" Foreground="{StaticResource HeaderBrush}"/>
                                                <TextBox x:Name="PosXTextBox" Grid.Column="1" Background="#333333" Foreground="White" Margin="0,0,5,5" TextChanged="Coordinate_TextChanged" BorderThickness="1" BorderBrush="#3F3F46" Padding="2"/>
                                                <TextBlock Text="Y" Grid.Column="2" Margin="0,0,5,5" Foreground="{StaticResource HeaderBrush}"/>
                                                <TextBox x:Name="PosYTextBox" Grid.Column="3" Background="#333333" Foreground="White" Margin="0,0,0,5" TextChanged="Coordinate_TextChanged" BorderThickness="1" BorderBrush="#3F3F46" Padding="2"/>

                                                <TextBlock Text="Z" Grid.Row="1" Margin="0,0,5,0" Foreground="{StaticResource HeaderBrush}"/>
                                                <TextBox x:Name="PosZTextBox" Grid.Row="1" Grid.Column="1" Background="#333333" Foreground="White" Margin="0,0,5,0" TextChanged="Coordinate_TextChanged" BorderThickness="1" BorderBrush="#3F3F46" Padding="2"/>
                                                <TextBlock Text="RY" Grid.Row="1" Grid.Column="2" Margin="0,0,5,0" Foreground="{StaticResource HeaderBrush}"/>
                                                <TextBox x:Name="RotYTextBox" Grid.Row="1" Grid.Column="3" Background="#333333" Foreground="White" TextChanged="Coordinate_TextChanged" BorderThickness="1" BorderBrush="#3F3F46" Padding="2"/>
                                                <TextBlock Text="RX" Grid.Row="2"/><TextBox x:Name="RotXTextBox" Grid.Row="2" Grid.Column="1" Background="#333333" Foreground="White" TextChanged="Coordinate_TextChanged"/>
                                                <TextBlock Text="RZ" Grid.Row="2" Grid.Column="2"/><TextBox x:Name="RotZTextBox" Grid.Row="2" Grid.Column="3" Background="#333333" Foreground="White" TextChanged="Coordinate_TextChanged"/>
                                            </Grid>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                                
                                <TextBlock x:Name="NoSelectionText" Text="No object selected" FontStyle="Italic" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" 
                                           Foreground="White" Margin="0,50,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                  </Grid>
                  <ScrollViewer x:Name="MeshModePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                      <TextBlock Text="Mesh editor" FontSize="20" Margin="0,0,0,12"/>
                      <TextBlock Text="Movement target" Margin="0,0,0,5"/>
                      <ComboBox x:Name="MeshMovementTarget" SelectionChanged="MeshTool_Changed" SelectedIndex="0" Margin="0,0,0,12">
                        <ComboBoxItem Content="Mesh and collision (matching vertices)"/>
                        <ComboBoxItem Content="Mesh only; keep collision"/>
                        <ComboBoxItem Content="Collision only; keep mesh"/>
                      </ComboBox>
                      <UniformGrid Columns="4" Margin="0,0,0,12">
                        <RadioButton x:Name="MeshEditTool" Foreground="White" GroupName="MeshTool" Content="Edit" IsChecked="True" Checked="MeshTool_Changed"/>
                        <RadioButton x:Name="MeshPaintTool" Foreground="White" GroupName="MeshTool" Content="Paint" Checked="MeshTool_Changed"/>
                        <RadioButton x:Name="MeshBoxTool" Foreground="White" GroupName="MeshTool" Content="Box" Checked="MeshTool_Changed"/>
                        <RadioButton x:Name="CollisionTypeTool" Foreground="White" GroupName="MeshTool" Content="Collision" Checked="MeshTool_Changed"/>
                      </UniformGrid>
                      <TextBlock x:Name="MeshToolHint" TextWrapping="Wrap" Margin="0,0,0,15"/>
                      <StackPanel x:Name="MeshEditOptions">
                        <WrapPanel Margin="0,0,0,10">
                          <RadioButton x:Name="MeshVertexSelection" Content="Vertices" GroupName="MeshSelection" Foreground="White" IsChecked="True" Checked="MeshTool_Changed" Margin="0,0,16,0"/>
                          <RadioButton x:Name="MeshFaceSelection" Content="Faces" GroupName="MeshSelection" Foreground="White" Checked="MeshTool_Changed"/>
                        </WrapPanel>
                        <TextBlock Text="Drag in the viewport or nudge below" Margin="0,0,0,6"/>
                        <TextBlock Text="Step in game units"/>
                        <TextBox x:Name="MeshMoveStep" Text="50" Margin="0,4,0,8"/>
                        <UniformGrid Columns="3">
                          <Button Content="X -" Tag="-x" Click="MoveMeshVertex_Click" Margin="2"/>
                          <Button Content="Y -" Tag="-y" Click="MoveMeshVertex_Click" Margin="2"/>
                          <Button Content="Z -" Tag="-z" Click="MoveMeshVertex_Click" Margin="2"/>
                          <Button Content="X +" Tag="x" Click="MoveMeshVertex_Click" Margin="2"/>
                          <Button Content="Y +" Tag="y" Click="MoveMeshVertex_Click" Margin="2"/>
                          <Button Content="Z +" Tag="z" Click="MoveMeshVertex_Click" Margin="2"/>
                        </UniformGrid>
                      </StackPanel>
                      <StackPanel x:Name="MeshPaintOptions" Visibility="Collapsed">
                        <TextBlock Text="Level texture" Margin="0,0,0,6"/>
                        <ComboBox x:Name="MeshPaintTextureCombo" SelectionChanged="MeshPaintTexture_Changed"/>
                        <Image x:Name="MeshTexturePreview" Width="96" Height="96" HorizontalAlignment="Left" Margin="0,8" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <TextBlock Text="Click or drag across faces to paint textures; save when ready" TextWrapping="Wrap" Margin="0,8,0,0"/>
                      </StackPanel>
                      <StackPanel x:Name="MeshBoxOptions" Visibility="Collapsed">
                        <TextBlock Text="Box size in game units"/>
                        <TextBox x:Name="MeshBoxSize" Text="500" Margin="0,6"/>
                        <CheckBox x:Name="MeshBoxCollision" Content="Include collision" IsChecked="True" Margin="0,6"/>
                        <Button Content="Place box..." Click="PlaceMeshBox_Click" Padding="10,6" Margin="0,8"/>
                      </StackPanel>
                      <StackPanel x:Name="CollisionSurfaceOptions" Visibility="Collapsed">
                        <TextBlock Text="Collision surface type" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CollisionSurfaceSelector" DisplayMemberPath="Name" SelectionChanged="CollisionSurface_Changed">
                          <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                              <Setter Property="IsEnabled" Value="{Binding IsSupported}"/>
                              <Setter Property="ToolTip" Value="{Binding Reason}"/>
                              <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                            </Style>
                          </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <TextBlock x:Name="CollisionSurfaceHelp" TextWrapping="Wrap" Margin="0,8"/>
                        <TextBlock Text="Force parameter (decimal or 0x hex)"/>
                        <TextBox x:Name="CollisionForceText" Text="0" TextChanged="CollisionForce_Changed" Margin="0,6"/>
                        <TextBlock Text="Click or drag collision faces to apply the type. disabled types lack verified level support." TextWrapping="Wrap" Margin="0,8"/>
                      </StackPanel>
                      <TextBlock x:Name="MeshSelectionText" Text="No mesh vertex selected" TextWrapping="Wrap" Margin="0,18"/>
                      <Button x:Name="MeshSaveButton" Content="Save geometry" Click="SaveMeshSession_Click" Padding="8" Margin="0,0,0,8"/>
                      <Button Content="Level mesh viewer..." Click="LevelMeshEditorButton_Click" Padding="8"/>
                      <TextBlock Text="Open the editable tables for detailed geometry, imports and water boxes" TextWrapping="Wrap" Margin="0,8" Opacity="0.7"/>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#343942" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
            <!-- RIGHT WORKSPACE (Viewport + Controls) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="MeshDockRow" Height="0"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#252A33" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="12,9">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,9">
                            <Button DockPanel.Dock="Right" Content="Frame level" Click="FrameLevel_Click" Padding="10,4" Background="#3E4654" Foreground="White" BorderThickness="0" ToolTip="Fit the entire area in the viewport"/>
                            <Button DockPanel.Dock="Right" Content="Level mesh viewer" Click="LevelMeshEditorButton_Click" Padding="10,4" Margin="0,0,8,0" Background="#007ACC" Foreground="White" BorderThickness="0" ToolTip="Editable geometry tables"/>
                            <Button x:Name="LiveEditingButton" Content="Connect Live Editing" Click="LiveEditing_Click" Margin="8,0" DockPanel.Dock="Right"/><TextBlock x:Name="SceneInfoText" Text="Loading level…" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <RadioButton x:Name="ActorObjectMode" Content="Actor/object editor" GroupName="EditMode" IsChecked="True" Checked="EditMode_Changed" Margin="0,0,20,0" Foreground="White"/>
                            <RadioButton x:Name="LevelMeshMode" Content="Mesh editor" GroupName="EditMode" Checked="EditMode_Changed" Foreground="White"/>
                        </WrapPanel>
                        <WrapPanel>
                            <CheckBox x:Name="TerrainViewCheckBox" Content="Terrain" IsChecked="True" Checked="ViewSettings_Changed" Unchecked="ViewSettings_Changed"/>
                            <CheckBox x:Name="SkyboxViewCheckBox" Content="Skybox" IsChecked="True" Checked="ViewSettings_Changed" Unchecked="ViewSettings_Changed"/>
                            <CheckBox x:Name="WaterViewCheckBox" Content="Water" IsChecked="True" Checked="ViewSettings_Changed" Unchecked="ViewSettings_Changed"/>
                            <CheckBox x:Name="ActorsViewCheckBox" Content="Actors" IsChecked="True" Checked="ViewSettings_Changed" Unchecked="ViewSettings_Changed" ToolTip="Preview registered actor models at their placed transforms"/>
                            <CheckBox x:Name="AnimateActorsCheckBox" Content="Animate" IsChecked="True" IsEnabled="{Binding IsChecked, ElementName=ActorsViewCheckBox}" Checked="ViewSettings_Changed" Unchecked="ViewSettings_Changed"/>
                            <CheckBox x:Name="CollisionViewCheckBox" Content="Collision" IsChecked="False" Checked="ViewSettings_Changed" Unchecked="ViewSettings_Changed" ToolTip="Collision wireframe (C)"/>
                            <CheckBox x:Name="MarkersViewCheckBox" Content="Markers" IsChecked="False" Checked="ViewSettings_Changed" Unchecked="ViewSettings_Changed" ToolTip="Object and invisible trigger markers"/>
                        </WrapPanel>
                        <TextBlock Text="WASD move · Space/X up/down · Shift fast · Ctrl precise · Middle-drag pan · Right-drag orbit · Wheel zoom" TextWrapping="Wrap" Foreground="#9CA9B9" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Viewport Container -->
                <Border Grid.Row="1" Background="Black" x:Name="RendererContainer" MouseDown="RendererContainer_MouseDown" Focusable="True">
                    <Grid x:Name="HostGrid">
                        <TextBlock Text="3D VIEWER" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Opacity="0.3"/>
                    </Grid>
                </Border>

                <!-- BOTTOM CONTROLS -->
                <Border Grid.Row="2" x:Name="MeshDock" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0"/>
                <GridSplitter Grid.Row="2" Height="5" VerticalAlignment="Top" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndCurrent" Background="#485261"/>
                <Border Grid.Row="3" x:Name="NavigationControls" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Movement Gizmos -->
                            <ColumnDefinition Width="*"/>    <!-- Sliders -->
                            <ColumnDefinition Width="Auto"/> <!-- Camera Mode -->
                        </Grid.ColumnDefinitions>

                        <!-- Gizmos -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Movement" Foreground="{StaticResource HeaderBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <Grid Width="80" Height="80">
                                    <Button Content="▲" Margin="0,0,0,54" Width="24" Height="24" Background="#DC3545" Foreground="White" Click="GizmoMove_Click" BorderThickness="0"/>
                                    <Button Content="▼" Margin="0,54,0,0" Width="24" Height="24" Background="#DC3545" Foreground="White" Click="GizmoMove_Click" BorderThickness="0"/>
                                    <Button Content="◀" Margin="0,0,54,0" Width="24" Height="24" Background="#28A745" Foreground="White" Click="GizmoMove_Click" BorderThickness="0"/>
                                    <Button Content="▶" Margin="54,0,0,0" Width="24" Height="24" Background="#28A745" Foreground="White" Click="GizmoMove_Click" BorderThickness="0"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Height" Foreground="{StaticResource HeaderBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <Button Content="➕" Width="24" Height="24" Background="#00A2FF" Foreground="White" Margin="0,0,0,5" Click="GizmoMove_Click" BorderThickness="0"/>
                                <Button Content="➖" Width="24" Height="24" Background="#00A2FF" Foreground="White" Click="GizmoMove_Click" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Sliders -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="MOVE SPEED" VerticalAlignment="Center" Foreground="#CE9178" FontWeight="Bold" FontSize="11"/>
                                <Slider Grid.Column="1" Value="100" Minimum="10" Maximum="500" Margin="10,0" ValueChanged="MoveSpeedSlider_ValueChanged" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Grid.Column="2" x:Name="MoveSpeedText" Text="100%" VerticalAlignment="Center" Foreground="White"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CAMERA SPEED" VerticalAlignment="Center" Foreground="#CE9178" FontWeight="Bold" FontSize="11"/>
                                <Slider Grid.Column="1" Value="100" Minimum="10" Maximum="500" Margin="10,0" ValueChanged="CameraSpeedSlider_ValueChanged" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Grid.Column="2" x:Name="CameraSpeedText" Text="100%" VerticalAlignment="Center" Foreground="White"/>
                            </Grid>
                        </StackPanel>

                        <!-- Mode & Drop & Debugger -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Content="🔍 Open Scan Debugger" Padding="10,5" Margin="0,0,0,5" Background="#007ACC" Foreground="White" BorderThickness="0" Click="OpenScanDebugger_Click"/>
                            <Button Content="Drop To Ground" Padding="10,5" Margin="0,0,0,5" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="DropToGround_Click"/>
                            <Button Content="Focus selected" Click="FocusSelected_Click" Padding="10,5" Background="#3E4654" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>


