<Window x:Class="Sm64DecompLevelViewer.DisplayListChaosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display List Chaos Manager" Height="610" Width="620"
        Background="#121212" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#333333"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1C97EA"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="DISPLAY LIST CHAOS" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Skip actual nested display-list calls in actor and level source" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Configuration Panel -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Exclusion mode / alternative severity:" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="AlternativeComboBox" SelectedIndex="0" SelectionChanged="Alternative_Changed" Margin="0,0,0,12">
                    <ComboBoxItem Content="Original: Seeded Call Exclusions"/>
                    <ComboBoxItem Content="Severity 1: Hide HUD"/>
                    <ComboBoxItem Content="Severity 2: Missing Actor Details, Shadows and Waterfalls"/>
                    <ComboBoxItem Content="Severity 3: Hide Actor Models and Water Surfaces"/>
                    <ComboBoxItem Content="Severity 4: Hide Mario Left Limbs"/>
                    <ComboBoxItem Content="Severity 5: Mario Body Only"/>
                    <ComboBoxItem Content="Severity 6: Torso, Missing Texture Details and Actors"/>
                    <ComboBoxItem Content="Severity 7: Level and Skybox, Some Geometry Missing"/>
                    <ComboBoxItem Content="Severity 8: Half the Level Missing"/>
                </ComboBox>
                <!-- Slider -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Exclusion Density:" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="LevelValueText" Grid.Column="1" Margin="16,0,0,0" Text="Level 0 (Disabled)" FontSize="13" FontWeight="Bold" Foreground="#4CAF50"/>
                </Grid>
                <Slider x:Name="LevelSlider" Minimum="0" Maximum="9" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,15" ValueChanged="LevelSlider_ValueChanged"/>

                <!-- Description box -->
                <Border Background="#151515" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="4" Padding="10" MinHeight="65" Margin="0,0,0,15">
                    <TextBlock x:Name="DescriptionText" Text="Select a level to see the exclusion effects." Foreground="#CCCCCC" TextWrapping="Wrap" FontSize="12" FontStyle="Italic"/>
                </Border>

                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Pattern seed:" Width="130" VerticalAlignment="Center"/>
                    <TextBox x:Name="SeedTextBox" Text="0" Width="160" HorizontalAlignment="Left"/>
                </DockPanel>
                <CheckBox x:Name="IncludeBranchesCheck" Content="Include branch-list tails" IsChecked="True" Foreground="#CCCCCC" Margin="0,0,0,10"/>
                <TextBlock Text="Source edits require a ROM rebuild. Alternative severity levels are cumulative. Skyboxes and gameplay logic are preserved. Remove Exclusions restores both modes." Foreground="#999999" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Remove Exclusions" Click="Restore_Click" Grid.Column="0" Height="30" Margin="0,0,5,0" Background="#3E3E42" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
            <Button Content="Apply &amp; Patch Decomp" Click="Apply_Click" Grid.Column="1" Height="30" Margin="5,0,0,0" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
